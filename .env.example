# GitHub Personal Access Token (Fine-grained, Read-only)
# https://github.com/settings/personal-access-tokens
GITHUB_PAT=

# GitHub username/org
GITHUB_OWNER=

# Repository names to expose (comma-separated)
GITHUB_REPOS=

# File tree default expansion depth (0 = all collapsed, 1 = root expanded, etc.)
FILE_TREE_DEPTH=0

# Number of commits per page on the commits list (default: 20, GitHub API max: 100).
COMMITS_PER_PAGE=20

# Number of pull requests per page on the pulls list (default: 10, GitHub API max: 100).
PULLS_PER_PAGE=10

# Access token for the share link (e.g. a long random string)
# Share URL: https://your-domain.com/?token=<SHARE_TOKEN>
# Leave empty to block all access.
SHARE_TOKEN=

# Enable Vercel Web Analytics (set to "true" to load the tracking script).
# Disabled by default: self-hosted deployments ship no tracking script unless you explicitly enable it.
# Requires deploying to Vercel with Web Analytics enabled for the project.
ENABLE_ANALYTICS=

# Allow search engines to index this deployment (set to "true" to opt in).
# Disabled by default: showmycode shares private repositories, so an instance
# running in public mode would otherwise let crawlers index the repository names
# it serves and the code behind them. Only enable this on a public demo or landing site.
ENABLE_SEO=

# Public origin of this deployment, used for canonical URLs, sitemap, and link previews.
# Optional on Vercel: falls back to the project's production domain, then to http://localhost:3000.
# Set it explicitly when ENABLE_SEO=true, so canonical URLs cannot fall back to localhost.
SITE_URL=
